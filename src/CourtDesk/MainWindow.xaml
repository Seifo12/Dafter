<Window x:Class="CourtDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:CourtDesk.Resources"
        xmlns:shell="clr-namespace:CourtDesk.UI.Shell"
        xmlns:views="clr-namespace:CourtDesk.UI.Views"
        Title="{x:Static res:Strings.AppTitle}"
        FlowDirection="RightToLeft" xml:lang="ar-EG"
        WindowState="Maximized" MinWidth="1024" MinHeight="700">
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid x:Name="Root" x:FieldModifier="public" MinHeight="600">
    <Grid.LayoutTransform>
      <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
    </Grid.LayoutTransform>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <shell:TopBar Grid.Row="0" DataContext="{Binding}" x:Name="Bar" />
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <views:TodaySidebar Grid.Column="0" DataContext="{Binding Sidebar}" />
      <ContentControl Grid.Column="1" x:Name="Host">
        <views:RegisterView DataContext="{Binding Register}" x:Name="RegisterView" x:FieldModifier="public" />
      </ContentControl>
    </Grid>
    <StatusBar Grid.Row="2" FontSize="20" MinHeight="48" FontFamily="{StaticResource AppFont}">
      <DockPanel LastChildFill="True">
        <TextBlock Text="{Binding StatusRecords}" Margin="12,0" />
        <TextBlock Text="{Binding StatusExit}" Margin="12,0" />
        <TextBlock Text="{Binding StatusUsb}" Margin="12,0" />
      </DockPanel>
    </StatusBar>
  </Grid>
  </ScrollViewer>
</Window>
