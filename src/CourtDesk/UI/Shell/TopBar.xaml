<UserControl x:Class="CourtDesk.UI.Shell.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:CourtDesk.Resources"
             FlowDirection="RightToLeft">
  <Border Background="{StaticResource HeaderBrush}" Padding="12,8">
    <Grid Height="48">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <Path Data="{StaticResource IconShield}" Stroke="{StaticResource WhiteBrush}" StrokeThickness="2"
              Fill="Transparent" Width="28" Height="28" VerticalAlignment="Center" />
        <StackPanel VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="230" x:Name="BrandBlock">
          <TextBlock Text="{x:Static res:Strings.AppTitle}" Style="{StaticResource BrandText}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding StationLine}" Style="{StaticResource BrandSubText}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                  VerticalAlignment="Center" x:Name="NavRowWide">
        <RadioButton Content="{x:Static res:Strings.NavRegister}" Style="{StaticResource NavTab}"
                     GroupName="nav" IsChecked="True"
                     Command="{Binding NavCommand}" CommandParameter="register" />
        <RadioButton Content="{x:Static res:Strings.NavSchedule}" Style="{StaticResource NavTab}"
                     GroupName="nav" Command="{Binding NavCommand}" CommandParameter="schedule" />
        <RadioButton Content="{x:Static res:Strings.NavHistory}" Style="{StaticResource NavTab}"
                     GroupName="nav" Command="{Binding NavCommand}" CommandParameter="history" />
        <RadioButton Content="{x:Static res:Strings.NavBackup}" Style="{StaticResource NavTab}"
                     GroupName="nav" Command="{Binding NavCommand}" CommandParameter="backup" />
      </StackPanel>

      <UniformGrid Grid.Column="1" Rows="1" Columns="4" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Visibility="Collapsed" x:Name="NavRowCompact">
        <RadioButton Content="{x:Static res:Strings.NavRegister}" Style="{StaticResource NavTabCompact}"
                     GroupName="navc" IsChecked="True"
                     Command="{Binding NavCommand}" CommandParameter="register" />
        <RadioButton Content="{x:Static res:Strings.NavSchedule}" Style="{StaticResource NavTabCompact}"
                     GroupName="navc" Command="{Binding NavCommand}" CommandParameter="schedule" />
        <RadioButton Content="{x:Static res:Strings.NavHistory}" Style="{StaticResource NavTabCompact}"
                     GroupName="navc" Command="{Binding NavCommand}" CommandParameter="history" />
        <RadioButton Content="{x:Static res:Strings.NavBackup}" Style="{StaticResource NavTabCompact}"
                     GroupName="navc" Command="{Binding NavCommand}" CommandParameter="backup" />
      </UniformGrid>

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" x:Name="Tools">
        <TextBlock Text="{x:Static res:Strings.FontLabel}" Style="{StaticResource BrandSubText}"
                   VerticalAlignment="Center" Margin="0,0,6,0" x:Name="FontLabelText" />
        <Button Style="{StaticResource HeaderUtilityButton}" Command="{Binding ZoomOutCommand}" MinWidth="48"
                Content="&#x2212;" />
        <Button Style="{StaticResource HeaderUtilityButton}" Command="{Binding ZoomInCommand}" MinWidth="48"
                Content="+" />
        <Button x:Name="HelpButton" Style="{StaticResource HeaderUtilityButton}" MinWidth="120"
                Content="{x:Static res:Strings.NavHelp}" Command="{Binding HelpCommand}" />
        <Button x:Name="ExitButton" Style="{StaticResource HeaderUtilityButton}" MinWidth="120"
                Content="{x:Static res:Strings.NavExit}" Command="{Binding CloseCommand}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>