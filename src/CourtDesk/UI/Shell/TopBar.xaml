<UserControl x:Class="CourtDesk.UI.Shell.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:CourtDesk.Resources"
             FlowDirection="RightToLeft" MinHeight="76">
  <StackPanel Background="{StaticResource SurfaceAltBrush}" Margin="6,4">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="6,0,12,0" MaxWidth="330">
        <TextBlock Text="{x:Static res:Strings.AppTitle}" Style="{StaticResource TitleSection}" FontSize="24" />
        <TextBlock Text="{Binding TodayLong}" Style="{StaticResource BaseText}" FontSize="20" FontWeight="Bold"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding StationLine}" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{x:Static res:Strings.RosterMinistry}" Style="{StaticResource HintText}"
                 VerticalAlignment="Center" Margin="8,0" TextAlignment="Center" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,6,0">
        <Button Content="{x:Static res:Strings.FontSmaller}" Style="{StaticResource SmallButton}"
                MinWidth="110" Margin="2" Command="{Binding ZoomOutCommand}" />
        <Button Content="{x:Static res:Strings.FontLarger}" Style="{StaticResource SmallButton}"
                MinWidth="110" Margin="2" Command="{Binding ZoomInCommand}" />
        <Button Content="{x:Static res:Strings.NavHelp}" Style="{StaticResource SmallButton}"
                MinWidth="100" Margin="2" Command="{Binding HelpCommand}" />
        <Button Content="{x:Static res:Strings.NavExit}" Style="{StaticResource SmallButton}"
                MinWidth="150" Margin="2" Command="{Binding CloseCommand}" />
      </StackPanel>
    </Grid>
    <UniformGrid Rows="1" Columns="4" Margin="4,4,4,0">
      <Button Content="{x:Static res:Strings.NavRegister}" Style="{StaticResource SmallButton}"
              Margin="4,0" Command="{Binding NavCommand}" CommandParameter="register" />
      <Button Content="{x:Static res:Strings.NavSchedule}" Style="{StaticResource SmallButton}"
              Margin="4,0" Command="{Binding NavCommand}" CommandParameter="schedule" />
      <Button Content="{x:Static res:Strings.NavHistory}" Style="{StaticResource SmallButton}"
              Margin="4,0" Command="{Binding NavCommand}" CommandParameter="history" />
      <Button Content="{x:Static res:Strings.NavBackup}" Style="{StaticResource SmallButton}"
              Margin="4,0" Command="{Binding NavCommand}" CommandParameter="backup" />
    </UniformGrid>
  </StackPanel>
</UserControl>