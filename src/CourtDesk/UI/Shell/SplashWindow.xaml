<Window x:Class="CourtDesk.UI.Shell.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:CourtDesk.Resources"
        Title="{x:Static res:Strings.AppTitle}" FlowDirection="RightToLeft"
        Width="520" Height="300" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        Background="{StaticResource CardBrush}">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
    <TextBlock Text="{x:Static res:Strings.AppTitle}" Style="{StaticResource TitleDialog}"
               TextAlignment="Center" TextWrapping="Wrap" />
    <TextBlock Text="{x:Static res:Strings.SplashWait}" Style="{StaticResource BaseText}"
               TextAlignment="Center" Margin="0,24,0,0" />
  </StackPanel>
</Window>
