<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="AppFont">Tahoma, Segoe UI, Arial</FontFamily>

  <Style x:Key="BaseText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>

  <Style x:Key="NameText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="TitleWindow" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="TitleDialog" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="TitleSection" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="GridHeaderText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="GridStrong" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="ChipText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>

  <Style x:Key="ButtonText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="BrandText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
  </Style>

  <Style x:Key="BrandSubText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
  </Style>
</ResourceDictionary>