<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Canvas">#EEF1F5</Color>
  <Color x:Key="Card">#FFFFFF</Color>
  <Color x:Key="CardBorder">#D3D9E2</Color>
  <Color x:Key="Ink">#1B2430</Color>
  <Color x:Key="Muted">#46505E</Color>
  <Color x:Key="Primary">#084A8F</Color>
  <Color x:Key="Header">#0B3A75</Color>

  <Color x:Key="Tonal">#E3ECF7</Color>
  <Color x:Key="Hover">#EEF4FB</Color>
  <Color x:Key="GridHeaderBg">#E8EDF3</Color>
  <Color x:Key="GridLine">#E1E6ED</Color>
  <Color x:Key="SelectedBg">#D6E8FA</Color>
  <Color x:Key="DangerQuiet">#A32D2D</Color>
  <Color x:Key="White">#FFFFFF</Color>
  <Color x:Key="White60">#99FFFFFF</Color>
  <Color x:Key="White15">#26FFFFFF</Color>
  <Color x:Key="FocusYellow">#FFD400</Color>

  <Color x:Key="TodayFg">#8A5A00</Color>
  <Color x:Key="TodayBg">#FFF1B8</Color>
  <Color x:Key="OverdueFg">#A32D2D</Color>
  <Color x:Key="OverdueBg">#FFD9D4</Color>
  <Color x:Key="UpcomingFg">#0B5CAD</Color>
  <Color x:Key="UpcomingBg">#D6E8FA</Color>
  <Color x:Key="ReleasedFg">#1B6E2D</Color>
  <Color x:Key="ReleasedBg">#D5EFDA</Color>
  <Color x:Key="JudgedFg">#5B3FA3</Color>
  <Color x:Key="JudgedBg">#E4DDF4</Color>
  <Color x:Key="NoDateFg">#46505E</Color>
  <Color x:Key="NoDateBg">#EDEDED</Color>

  <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource Canvas}" />
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource Card}" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorder}" />
  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
  <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource Header}" />
  <SolidColorBrush x:Key="TonalBrush" Color="{StaticResource Tonal}" />
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource Hover}" />
  <SolidColorBrush x:Key="GridHeaderBgBrush" Color="{StaticResource GridHeaderBg}" />
  <SolidColorBrush x:Key="GridLineBrush" Color="{StaticResource GridLine}" />
  <SolidColorBrush x:Key="SelectedBgBrush" Color="{StaticResource SelectedBg}" />
  <SolidColorBrush x:Key="DangerQuietBrush" Color="{StaticResource DangerQuiet}" />
  <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
  <SolidColorBrush x:Key="White60Brush" Color="{StaticResource White60}" />
  <SolidColorBrush x:Key="White15Brush" Color="{StaticResource White15}" />
  <SolidColorBrush x:Key="FocusYellowBrush" Color="{StaticResource FocusYellow}" />

  <SolidColorBrush x:Key="TodayFgBrush" Color="{StaticResource TodayFg}" />
  <SolidColorBrush x:Key="TodayBgBrush" Color="{StaticResource TodayBg}" />
  <SolidColorBrush x:Key="OverdueFgBrush" Color="{StaticResource OverdueFg}" />
  <SolidColorBrush x:Key="OverdueBgBrush" Color="{StaticResource OverdueBg}" />
  <SolidColorBrush x:Key="UpcomingFgBrush" Color="{StaticResource UpcomingFg}" />
  <SolidColorBrush x:Key="UpcomingBgBrush" Color="{StaticResource UpcomingBg}" />
  <SolidColorBrush x:Key="ReleasedFgBrush" Color="{StaticResource ReleasedFg}" />
  <SolidColorBrush x:Key="ReleasedBgBrush" Color="{StaticResource ReleasedBg}" />
  <SolidColorBrush x:Key="JudgedFgBrush" Color="{StaticResource JudgedFg}" />
  <SolidColorBrush x:Key="JudgedBgBrush" Color="{StaticResource JudgedBg}" />
  <SolidColorBrush x:Key="NoDateFgBrush" Color="{StaticResource NoDateFg}" />
  <SolidColorBrush x:Key="NoDateBgBrush" Color="{StaticResource NoDateBg}" />
</ResourceDictionary>