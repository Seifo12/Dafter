<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Surface">#FFFFFF</Color>
  <Color x:Key="SurfaceAlt">#F5F3EE</Color>
  <Color x:Key="Ink">#151515</Color>
  <Color x:Key="InkMuted">#4A4A4A</Color>
  <Color x:Key="Border">#6B6B6B</Color>
  <Color x:Key="Primary">#084A8F</Color>
  <Color x:Key="Danger">#B3261E</Color>
  <Color x:Key="FocusBlack">#000000</Color>
  <Color x:Key="FocusYellow">#FFD400</Color>
  <Color x:Key="HeaderGrey">#E6E6E6</Color>

  <Color x:Key="TodayBg">#FFF1B8</Color>
  <Color x:Key="TodayAccent">#8A5A00</Color>
  <Color x:Key="OverdueBg">#FFD9D4</Color>
  <Color x:Key="OverdueAccent">#B3261E</Color>
  <Color x:Key="UpcomingBg">#D6E8FA</Color>
  <Color x:Key="UpcomingAccent">#0B5CAD</Color>
  <Color x:Key="ReleasedBg">#D5EFDA</Color>
  <Color x:Key="ReleasedAccent">#1B6E2D</Color>
  <Color x:Key="JudgedBg">#E4DDF4</Color>
  <Color x:Key="JudgedAccent">#5B3FA3</Color>
  <Color x:Key="NoDateBg">#EDEDED</Color>
  <Color x:Key="NoDateAccent">#4A4A4A</Color>

  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAlt}" />
  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}" />
  <SolidColorBrush x:Key="InkMutedBrush" Color="{StaticResource InkMuted}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
  <SolidColorBrush x:Key="HeaderGreyBrush" Color="{StaticResource HeaderGrey}" />
  <SolidColorBrush x:Key="FocusYellowBrush" Color="{StaticResource FocusYellow}" />

  <SolidColorBrush x:Key="TodayBgBrush" Color="{StaticResource TodayBg}" />
  <SolidColorBrush x:Key="TodayAccentBrush" Color="{StaticResource TodayAccent}" />
  <SolidColorBrush x:Key="OverdueBgBrush" Color="{StaticResource OverdueBg}" />
  <SolidColorBrush x:Key="OverdueAccentBrush" Color="{StaticResource OverdueAccent}" />
  <SolidColorBrush x:Key="UpcomingBgBrush" Color="{StaticResource UpcomingBg}" />
  <SolidColorBrush x:Key="UpcomingAccentBrush" Color="{StaticResource UpcomingAccent}" />
  <SolidColorBrush x:Key="ReleasedBgBrush" Color="{StaticResource ReleasedBg}" />
  <SolidColorBrush x:Key="ReleasedAccentBrush" Color="{StaticResource ReleasedAccent}" />
  <SolidColorBrush x:Key="JudgedBgBrush" Color="{StaticResource JudgedBg}" />
  <SolidColorBrush x:Key="JudgedAccentBrush" Color="{StaticResource JudgedAccent}" />
  <SolidColorBrush x:Key="NoDateBgBrush" Color="{StaticResource NoDateBg}" />
  <SolidColorBrush x:Key="NoDateAccentBrush" Color="{StaticResource NoDateAccent}" />
</ResourceDictionary>
