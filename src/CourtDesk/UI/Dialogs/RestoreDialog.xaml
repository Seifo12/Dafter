<Window x:Class="CourtDesk.UI.Dialogs.RestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:CourtDesk.Resources"
        Title="{x:Static res:Strings.BkRestore}"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        Width="900" SizeToContent="Height" MinWidth="760" MinHeight="480">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{x:Static res:Strings.BkRestore}" Style="{StaticResource TitleSection}" />
      <TextBlock x:Name="CompareText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                 Margin="0,8,0,12" />
      <Border Style="{StaticResource TonalBand}" Padding="12">
        <TextBlock Text="{x:Static res:Strings.BkRestoreSafe}" Style="{StaticResource BaseText}"
                   TextWrapping="Wrap" />
      </Border>
    </StackPanel>
    <DataGrid x:Name="BackupGrid" DockPanel.Dock="Top" Height="300" IsReadOnly="True"
              AutoGenerateColumns="False" SelectionMode="Single" HeadersVisibility="Column"
              FontFamily="{StaticResource AppFont}" FontSize="20" Margin="0,12,0,0"
SelectionChanged="BackupGrid_SelectedItemChanged"
              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource CardBorderBrush}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{x:Static res:Strings.BkTier}" Binding="{Binding Tier}" Width="90" />
        <DataGridTextColumn Header="{x:Static res:Strings.BkFile}" Binding="{Binding FileName}" Width="*" />
        <DataGridTextColumn Header="{x:Static res:Strings.BkSize}" Binding="{Binding SizeText}" Width="120" />
        <DataGridTextColumn Header="{x:Static res:Strings.BkDate}" Binding="{Binding WrittenText}" Width="200" />
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,20,0,0">
      <Button x:Name="GoButton" Style="{StaticResource PrimaryButton}" MinWidth="200" Height="56"
              Margin="0,0,8,0" Click="GoClick" Content="{x:Static res:Strings.BkRestoreGo}" />
      <Button x:Name="BackButton" Style="{StaticResource SecondaryButton}" MinWidth="160" Height="56"
              Click="BackClick" Content="{x:Static res:Strings.BkRestoreBack}" />
    </StackPanel>
  </DockPanel>
</Window>