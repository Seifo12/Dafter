<Window x:Class="CourtDesk.UI.Dialogs.AskCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:CourtDesk.UI.Controls"
        xmlns:res="clr-namespace:CourtDesk.Resources"
        Title="{x:Static res:Strings.AppTitle}" FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource CardBrush}" SizeToContent="Height">
  <StackPanel Margin="24">
    <TextBlock x:Name="TitleText" Style="{StaticResource TitleDialog}" TextWrapping="Wrap" Margin="0,0,0,12" />
    <ContentControl x:Name="Host" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="OkButton" Content="{x:Static res:Strings.FormSave}" Style="{StaticResource PrimaryButton}"
              MinWidth="180" IsDefault="True" Click="OkClick" />
      <Button Content="{x:Static res:Strings.FormCancel}" Style="{StaticResource PrimaryButton}"
              MinWidth="180" IsCancel="True" Click="CancelClick" />
    </StackPanel>
  </StackPanel>
</Window>