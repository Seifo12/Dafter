<Window x:Class="CourtDesk.UI.Dialogs.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:CourtDesk.Resources"
        Title="{x:Static res:Strings.HelpTitle}"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        Width="900" Height="700" MinWidth="700" MinHeight="520">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="{x:Static res:Strings.HelpTitle}" Style="{StaticResource TitleSection}" />
    </StackPanel>
    <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButton}" MinHeight="56"
            MinWidth="200" HorizontalAlignment="Right" IsCancel="True" Click="CloseClick"
            Content="{x:Static res:Strings.FormCancel}" />
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="{x:Static res:Strings.Help1}" Style="{StaticResource BaseText}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock Text="{x:Static res:Strings.Help2}" Style="{StaticResource BaseText}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock Text="{x:Static res:Strings.Help3}" Style="{StaticResource BaseText}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock Text="{x:Static res:Strings.Help4}" Style="{StaticResource BaseText}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock Text="{x:Static res:Strings.Help5}" Style="{StaticResource BaseText}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock Text="{x:Static res:Strings.Help6}" Style="{StaticResource BaseText}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>