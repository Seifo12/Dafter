<Window x:Class="CourtDesk.UI.Dialogs.AskTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:CourtDesk.Resources"
        Title="{x:Static res:Strings.AppTitle}" FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource CardBrush}" SizeToContent="Height" Width="560">
  <StackPanel Margin="32">
    <TextBlock x:Name="TitleText" Style="{StaticResource TitleDialog}" TextWrapping="Wrap" Margin="0,0,0,12" />
    <TextBlock x:Name="LabelText" Style="{StaticResource BaseText}" Margin="0,0,0,6" />
    <TextBox x:Name="ValueBox" Style="{StaticResource InputBox}" FontSize="24" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="OkButton" Content="{x:Static res:Strings.FormSave}" Style="{StaticResource PrimaryButton}"
              MinWidth="180" IsDefault="True" Click="OkClick" />
      <Button Content="{x:Static res:Strings.FormCancel}" Style="{StaticResource PrimaryButton}"
              MinWidth="180" IsCancel="True" Click="CancelClick" />
    </StackPanel>
  </StackPanel>
</Window>