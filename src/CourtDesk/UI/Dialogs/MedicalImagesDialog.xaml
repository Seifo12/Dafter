<Window x:Class="CourtDesk.UI.Dialogs.MedicalImagesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:CourtDesk.Resources"
        Title="{x:Static res:Strings.MedicalTitle}" Height="620" Width="880"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource AppBgBrush}" FlowDirection="RightToLeft">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                   Margin="0,8" Text="{x:Static res:Strings.MedicalEmpty}" />
        <ItemsControl x:Name="List">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Width="248" Margin="0,0,10,10" Padding="8">
                <StackPanel>
                  <Border Background="{StaticResource MutedBgBrush}" Height="150"
                          CornerRadius="4" ClipToBounds="True">
                    <Image x:Name="Thumb" Stretch="Uniform" />
                  </Border>
                  <TextBlock Text="{Binding FileName}" Style="{StaticResource MutedText}"
                             TextWrapping="Wrap" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding Caption}" Style="{StaticResource MutedText}"
                             TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource QuietButton}" Content="{x:Static res:Strings.MedicalOpen}"
                            Tag="{Binding}" Click="OpenClick" MinHeight="40" Height="40"
                            MinWidth="90" Margin="0,0,6,0" />
                    <Button Style="{StaticResource QuietButton}" Content="{x:Static res:Strings.MedicalDelete}"
                            Tag="{Binding}" Click="DeleteClick" MinHeight="40" Height="40"
                            MinWidth="90" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
      <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Content="{x:Static res:Strings.MedicalAdd}"
              Click="AddClick" MinHeight="48" Height="48" MinWidth="160" Margin="0,0,8,0" />
      <Button Style="{StaticResource QuietButton}" Content="{x:Static res:Strings.FormCancel}" Click="CloseClick"
              MinHeight="48" Height="48" MinWidth="120" />
    </StackPanel>
  </Grid>
</Window>