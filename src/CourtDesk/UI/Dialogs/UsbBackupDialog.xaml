<Window x:Class="CourtDesk.UI.Dialogs.UsbBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:CourtDesk.Resources"
        Title="{x:Static res:Strings.BkUsb}"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        Width="720" SizeToContent="Height" MinWidth="640" MinHeight="380"
        ResizeMode="NoResize">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{x:Static res:Strings.BkUsbInsert}" Style="{StaticResource MutedText}"
                 TextWrapping="Wrap" Margin="0,0,0,12" x:Name="InsertText" />
      <ListBox x:Name="DriveList" Height="220" FontSize="20" FontFamily="{StaticResource AppFont}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
      <TextBlock x:Name="LastUsbText" Style="{StaticResource MutedText}" Margin="0,12,0,0"
                 TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,20,0,0">
      <Button x:Name="RetryButton" Style="{StaticResource SecondaryButton}" MinWidth="160"
              Height="56" Margin="0,0,8,0" Click="RetryClick" Content="{x:Static res:Strings.BkUsbRetry}" />
      <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" MinWidth="220"
              Height="56" Margin="0,0,8,0" Click="SaveClick" Content="{x:Static res:Strings.BkUsb}" />
      <Button x:Name="CloseButton" Style="{StaticResource SecondaryButton}" MinWidth="160"
              Height="56" Click="CloseClick" Content="{x:Static res:Strings.FormCancel}" />
    </StackPanel>
  </DockPanel>
</Window>