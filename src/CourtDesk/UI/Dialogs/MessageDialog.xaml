<Window x:Class="CourtDesk.UI.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:CourtDesk.Resources"
        Title="{x:Static res:Strings.AppTitle}" FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource CardBrush}" MaxWidth="760" SizeToContent="Height">
  <StackPanel Margin="32">
    <TextBlock x:Name="TitleText" Style="{StaticResource TitleDialog}" TextWrapping="Wrap" Margin="0,0,0,12" />
    <TextBlock x:Name="BodyText" Style="{StaticResource BaseText}" TextWrapping="Wrap" Margin="0,0,0,20" />
    <Button x:Name="OkButton" Content="{x:Static res:Strings.Ok}" Style="{StaticResource PrimaryButton}"
            HorizontalAlignment="Right" MinWidth="180" IsDefault="True" IsCancel="True" Click="OkClick" />
  </StackPanel>
</Window>