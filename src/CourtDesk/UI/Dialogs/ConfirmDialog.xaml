<Window x:Class="CourtDesk.UI.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:CourtDesk.Resources"
        Title="{x:Static res:Strings.AppTitle}" FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource CardBrush}" MaxWidth="760" SizeToContent="Height">
  <StackPanel Margin="32">
    <TextBlock x:Name="TitleText" Style="{StaticResource TitleDialog}" TextWrapping="Wrap" Margin="0,0,0,12" />
    <TextBlock x:Name="BodyText" Style="{StaticResource BaseText}" TextWrapping="Wrap" Margin="0,0,0,20" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="DangerButton" Style="{StaticResource DangerQuietButton}" MinWidth="200" Click="DangerClick" />
      <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" MinWidth="200" IsCancel="True" Click="PrimaryClick" />
    </StackPanel>
  </StackPanel>
</Window>