<Window x:Class="CourtDesk.UI.Dialogs.BackupSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:CourtDesk.Resources"
        Title="{x:Static res:Strings.NavBackup}"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        Width="900" Height="680" MinWidth="760" MinHeight="560">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="{x:Static res:Strings.NavBackup}" Style="{StaticResource TitleSection}" />
      <TextBlock x:Name="StatusLine" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                 Margin="0,6,0,0" />
    </StackPanel>
    <UniformGrid DockPanel.Dock="Bottom" Rows="1" Columns="3" Margin="0,16,0,0">
      <Button x:Name="UsbButton" Style="{StaticResource PrimaryButton}" MinHeight="56" Margin="0,0,6,0"
              Click="UsbClick" Content="{x:Static res:Strings.BkUsb}" />
      <Button x:Name="RestoreButton" Style="{StaticResource SecondaryButton}" MinHeight="56" Margin="6,0"
              Click="RestoreClick" Content="{x:Static res:Strings.BkRestore}" />
      <Button x:Name="CloseButton" Style="{StaticResource SecondaryButton}" MinHeight="56" Margin="6,0,0,0"
              Click="CloseClick" Content="{x:Static res:Strings.FormCancel}" />
    </UniformGrid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="{x:Static res:Strings.ExcelTitle}" Style="{StaticResource CardTitle}" />
            <TextBlock x:Name="ExcelHint" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                       TextWrapping="Wrap" Text="{x:Static res:Strings.ExcelHint}" />
            <UniformGrid Rows="1" Columns="3" Margin="0,8,0,0">
              <Button x:Name="TemplateButton" Style="{StaticResource SecondaryButton}" MinHeight="48"
                      MinWidth="180" Margin="0,0,4,0" Click="TemplateClick"
                      Content="{x:Static res:Strings.ExcelTemplate}" />
              <Button x:Name="ImportButton" Style="{StaticResource SecondaryButton}" MinHeight="48"
                      MinWidth="180" Margin="4,0" Click="ImportClick"
                      Content="{x:Static res:Strings.ExcelImport}" />
              <Button x:Name="ExportButton" Style="{StaticResource SecondaryButton}" MinHeight="48"
                      MinWidth="180" Margin="4,0,0,0" Click="ExportClick"
                      Content="{x:Static res:Strings.ExcelExport}" />
            </UniformGrid>
            <TextBlock Text="{x:Static res:Strings.ExcelScope}" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
            <ComboBox x:Name="ScopeBox" Style="{StaticResource BigCombo}" MinHeight="48"
                      HorizontalAlignment="Left" MinWidth="260"
                      SelectionChanged="ScopeChanged">
              <ComboBoxItem Content="{x:Static res:Strings.ExcelScopeAll}" Tag="ALL" IsSelected="True" />
              <ComboBoxItem Content="{x:Static res:Strings.ExcelScopeDetained}" Tag="DETAINED" />
              <ComboBoxItem Content="{x:Static res:Strings.ExcelScopeReleased}" Tag="RELEASED" />
              <ComboBoxItem Content="{x:Static res:Strings.ExcelScopeJudged}" Tag="JUDGED" />
              <ComboBoxItem Content="{x:Static res:Strings.ExcelScopeNoDate}" Tag="NO_DATE" />
            </ComboBox>
            <TextBlock Text="{x:Static res:Strings.ExcelScopePrint}" Style="{StaticResource MutedText}"
                       Margin="0,12,0,4" />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="ScopePreviewButton" Style="{StaticResource SecondaryButton}"
                      Content="{x:Static res:Strings.ExcelPreview}" Click="ScopePreviewClick" MinHeight="48" MinWidth="160"
                      Margin="0,0,8,0" />
              <Button x:Name="ScopePrintButton" Style="{StaticResource SecondaryButton}"
                      Content="{x:Static res:Strings.ExcelPrint}" Click="ScopePrintClick" MinHeight="48" MinWidth="160" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="{x:Static res:Strings.BkUsb}" Style="{StaticResource CardTitle}" />
            <TextBlock x:Name="LastUsbText" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="{x:Static res:Strings.SettingsDirectPrint}" Style="{StaticResource CardTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="DirectToggle" Style="{StaticResource SecondaryButton}" MinHeight="48"
                      MinWidth="220" Click="DirectClick" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16">
          <StackPanel>
            <TextBlock Text="{x:Static res:Strings.SettingsOffsets}" Style="{StaticResource CardTitle}" />
            <UniformGrid Rows="1" Columns="3" Margin="0,8,0,0">
              <Button Style="{StaticResource SecondaryButton}" MinHeight="48" Margin="0,0,4,0"
                      Click="OffsetMinus" Content="-" />
              <TextBlock x:Name="OffsetText" Style="{StaticResource GridStrong}" VerticalAlignment="Center"
                         TextAlignment="Center" />
              <Button Style="{StaticResource SecondaryButton}" MinHeight="48" Margin="4,0,0,0"
                      Click="OffsetPlus" Content="+" />
            </UniformGrid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,12">
          <StackPanel>
            <TextBlock Text="{x:Static res:Strings.OfficerTitle}"
                       Style="{StaticResource CardTitle}" />
            <TextBlock Text="{x:Static res:Strings.OfficerHint}"
                       Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
            <UniformGrid Rows="1" Columns="2" Margin="0,10,0,0">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="{x:Static res:Strings.OfficerName}" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                <TextBox x:Name="OperatorBox" Style="{StaticResource InputBox}" MinHeight="48" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Text="{x:Static res:Strings.OfficerDirectorate}" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                <TextBox x:Name="DirectorateBox" Style="{StaticResource InputBox}" MinHeight="48" />
              </StackPanel>
            </UniformGrid>
            <UniformGrid Rows="1" Columns="2" Margin="0,10,0,0">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="{x:Static res:Strings.OfficerStation}" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                <TextBox x:Name="StationBox" Style="{StaticResource InputBox}" MinHeight="48" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Text="{x:Static res:Strings.OfficerHeader}" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                <TextBox x:Name="HeaderBox" Style="{StaticResource InputBox}" MinHeight="48" />
              </StackPanel>
            </UniformGrid>
            <Button x:Name="SaveOfficerButton" Style="{StaticResource PrimaryButton}"
                    Content="{x:Static res:Strings.OfficerSave}" Click="SaveOfficerClick"
                    MinHeight="48" MinWidth="180" Margin="0,10,0,0" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>