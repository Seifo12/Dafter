<Window x:Class="CourtDesk.UI.Dialogs.BackupSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:CourtDesk.Resources"
        Title="{x:Static res:Strings.NavBackup}"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        Width="900" Height="680" MinWidth="760" MinHeight="560">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="{x:Static res:Strings.NavBackup}" Style="{StaticResource TitleSection}" />
      <TextBlock x:Name="StatusLine" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                 Margin="0,6,0,0" />
    </StackPanel>
    <UniformGrid DockPanel.Dock="Bottom" Rows="1" Columns="3" Margin="0,16,0,0">
      <Button x:Name="UsbButton" Style="{StaticResource PrimaryButton}" MinHeight="56" Margin="0,0,6,0"
              Click="UsbClick" Content="{x:Static res:Strings.BkUsb}" />
      <Button x:Name="RestoreButton" Style="{StaticResource SecondaryButton}" MinHeight="56" Margin="6,0"
              Click="RestoreClick" Content="{x:Static res:Strings.BkRestore}" />
      <Button x:Name="CloseButton" Style="{StaticResource SecondaryButton}" MinHeight="56" Margin="6,0,0,0"
              Click="CloseClick" Content="{x:Static res:Strings.FormCancel}" />
    </UniformGrid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="{x:Static res:Strings.BkUsb}" Style="{StaticResource CardTitle}" />
            <TextBlock x:Name="LastUsbText" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="{x:Static res:Strings.SettingsDirectPrint}" Style="{StaticResource CardTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="DirectToggle" Style="{StaticResource SecondaryButton}" MinHeight="48"
                      MinWidth="220" Click="DirectClick" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16">
          <StackPanel>
            <TextBlock Text="{x:Static res:Strings.SettingsOffsets}" Style="{StaticResource CardTitle}" />
            <UniformGrid Rows="1" Columns="3" Margin="0,8,0,0">
              <Button Style="{StaticResource SecondaryButton}" MinHeight="48" Margin="0,0,4,0"
                      Click="OffsetMinus" Content="-" />
              <TextBlock x:Name="OffsetText" Style="{StaticResource GridStrong}" VerticalAlignment="Center"
                         TextAlignment="Center" />
              <Button Style="{StaticResource SecondaryButton}" MinHeight="48" Margin="4,0,0,0"
                      Click="OffsetPlus" Content="+" />
            </UniformGrid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>