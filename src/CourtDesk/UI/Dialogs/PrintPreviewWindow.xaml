<Window x:Class="CourtDesk.UI.Dialogs.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:CourtDesk.Resources"
        Title="{x:Static res:Strings.PreviewTitle}"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        Width="1100" Height="780" MinWidth="760" MinHeight="560"
        SizeToContent="Manual">
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="16,0,16,16">
      <Button x:Name="DirectButton" Style="{StaticResource PrimaryButton}"
              MinWidth="200" Height="56" Margin="0,0,8,0" Click="DirectClick" />
      <Button x:Name="ChooseButton" Style="{StaticResource SecondaryButton}"
              MinWidth="260" Height="56" Margin="0,0,8,0" Click="ChooseClick" />
      <Button x:Name="CloseButton" Style="{StaticResource SecondaryButton}"
              MinWidth="160" Height="56" Click="CloseClick" />
    </StackPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="16,16,16,8" Padding="12">
      <TextBlock x:Name="InfoText" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
    </Border>
    <Border x:Name="DocumentHost" Margin="16,8,16,0" Background="Transparent" />
  </DockPanel>
</Window>