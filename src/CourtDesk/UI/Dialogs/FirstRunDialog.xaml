<Window x:Class="CourtDesk.UI.Dialogs.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:CourtDesk.Resources"
        Title="{x:Static res:Strings.FirstRunTitle}" FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}" SizeToContent="Height" Width="700">
  <StackPanel Margin="32">
    <TextBlock Text="{x:Static res:Strings.FirstRunTitle}" Style="{StaticResource TitleDialog}" Margin="0,0,0,8" />
    <TextBlock Style="{StaticResource BaseText}" TextWrapping="Wrap" Margin="0,0,0,20">
      <Run Text="{x:Static res:Strings.Help2}" />
    </TextBlock>
    <TextBlock Text="{x:Static res:Strings.FirstRunStation}" Style="{StaticResource BaseText}" Margin="0,0,0,4" />
    <TextBox x:Name="StationBox" Style="{StaticResource InputBox}" />
    <TextBlock Text="{x:Static res:Strings.FirstRunDirectorate}" Style="{StaticResource BaseText}" Margin="0,0,0,4" />
    <TextBox x:Name="DirectorateBox" Style="{StaticResource InputBox}" />
    <TextBlock Text="{x:Static res:Strings.FirstRunOperator}" Style="{StaticResource BaseText}" Margin="0,0,0,4" />
    <TextBox x:Name="OperatorBox" Style="{StaticResource InputBox}" />
    <Button x:Name="GoButton" Content="{x:Static res:Strings.FirstRunGo}"
            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
            MinWidth="220" Margin="0,16,0,0" IsDefault="True" Click="GoClick" />
  </StackPanel>
</Window>