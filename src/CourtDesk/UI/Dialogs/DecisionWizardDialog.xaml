<Window x:Class="CourtDesk.UI.Dialogs.DecisionWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:CourtDesk.Resources"
        xmlns:ctl="clr-namespace:CourtDesk.UI.Controls"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}" ResizeMode="CanResize"
        Width="960" Height="740" MinWidth="760" MinHeight="600"
        WindowStyle="SingleBorderWindow" ShowInTaskbar="False">
  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="{x:Static res:Strings.WizTitle}" Style="{StaticResource TitleDialog}" />
          <TextBlock x:Name="Identity" Style="{StaticResource BaseText}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
          <TextBlock x:Name="StepText" Style="{StaticResource TitleSection}" HorizontalAlignment="Left" />
          <TextBlock x:Name="QueueText" Style="{StaticResource MutedText}" HorizontalAlignment="Left" />
        </StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}" Padding="16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="PrimaryNext" Content="{x:Static res:Strings.WizNext}" Style="{StaticResource PrimaryButton}"
                MinWidth="180" Click="NextClick" />
        <Button x:Name="PrimarySave" Content="{x:Static res:Strings.WizSave}" Style="{StaticResource PrimaryButton}"
                MinWidth="220" Visibility="Collapsed" Click="SaveClick" />
        <Button x:Name="BackButton" Content="{x:Static res:Strings.WizBack}" Style="{StaticResource PrimaryButton}"
                MinWidth="160" Visibility="Collapsed" Click="BackClick" />
        <Button x:Name="CancelButton" Content="{x:Static res:Strings.WizCancel}" Style="{StaticResource PrimaryButton}"
                MinWidth="160" IsCancel="True" Click="CancelClick" />
      </StackPanel>
    </Border>
    <Grid Margin="16">
      <Grid x:Name="Step1">
        <StackPanel>
          <TextBlock Text="{x:Static res:Strings.WizQ1}" Style="{StaticResource TitleSection}" Margin="0,0,0,12" />
          <ItemsControl ItemsSource="{Binding Tiles}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}" Style="{StaticResource PrimaryButton}" MinHeight="110" MinWidth="300" Margin="8"
                        FontSize="24" FontWeight="Bold" Tag="{Binding}"
                        Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
      <Grid x:Name="Step2" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="{x:Static res:Strings.WizQ2}" Style="{StaticResource TitleSection}" Margin="0,0,0,8" />
          <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="PickDateButton" Content="{x:Static res:Strings.WizPickDate}"
                    Style="{StaticResource QuietButton}" MinWidth="240" Click="PickDateClick" />
          </WrapPanel>
          <ItemsControl ItemsSource="{Binding Offsets}" x:Name="OffsetsBox">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}" Style="{StaticResource PrimaryButton}" MinWidth="140"
                        Tag="{Binding Days}" Click="OffsetClick" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="ChosenLine" Style="{StaticResource BaseText}" FontWeight="Bold"
                     TextWrapping="Wrap" Margin="0,8,0,8" />
          <StackPanel x:Name="ReasonPanel" Margin="0,0,0,8">
            <TextBlock Text="{x:Static res:Strings.WizReason}" Style="{StaticResource BaseText}" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Reasons}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding Label}" Style="{StaticResource QuietButton}" MinWidth="140"
                          Tag="{Binding Label}" Click="ReasonClick" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel x:Name="BailPanel" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock Text="{x:Static res:Strings.WizBailAmount}" Style="{StaticResource BaseText}" />
            <TextBox x:Name="BailBox" Style="{StaticResource InputBox}" Text="{Binding Bail, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel x:Name="NotePanel" Margin="0,0,0,8">
            <TextBlock x:Name="NoteLabel" Text="{x:Static res:Strings.WizNote}" Style="{StaticResource BaseText}" />
            <TextBox x:Name="NoteBox" Style="{StaticResource InputBox}" AcceptsReturn="True" Height="80"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <Border Style="{StaticResource WarnBand}" x:Name="WarnPast" Visibility="Collapsed" Margin="0,4">
            <CheckBox x:Name="ConfirmPastBox" MinHeight="48" FontSize="20" IsChecked="{Binding ConfirmPast}">
              <StackPanel>
                <TextBlock Text="{x:Static res:Strings.WarnPast}" Style="{StaticResource BaseText}" />
                <TextBlock Text="{x:Static res:Strings.WarnConfirm}" Style="{StaticResource BaseText}" />
              </StackPanel>
            </CheckBox>
          </Border>
          <Border Style="{StaticResource WarnBand}" x:Name="WarnWeekend" Visibility="Collapsed" Margin="0,4">
            <CheckBox x:Name="ConfirmWeekendBox" MinHeight="48" FontSize="20" IsChecked="{Binding ConfirmWeekend}">
              <StackPanel>
                <TextBlock x:Name="WeekendText" Style="{StaticResource BaseText}" />
                <TextBlock Text="{x:Static res:Strings.WarnConfirm}" Style="{StaticResource BaseText}" />
              </StackPanel>
            </CheckBox>
          </Border>
          <Border Style="{StaticResource WarnBand}" x:Name="WarnFar" Visibility="Collapsed" Margin="0,4">
            <CheckBox x:Name="ConfirmFarBox" MinHeight="48" FontSize="20" IsChecked="{Binding ConfirmFar}">
              <StackPanel>
                <TextBlock x:Name="FarText" Style="{StaticResource BaseText}" />
                <TextBlock Text="{x:Static res:Strings.WarnConfirm}" Style="{StaticResource BaseText}" />
              </StackPanel>
            </CheckBox>
          </Border>
        </StackPanel>
      </Grid>
      <Grid x:Name="Step3" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="{x:Static res:Strings.WizQ3}" Style="{StaticResource TitleSection}" Margin="0,0,0,12" />
          <TextBlock x:Name="ReviewSentence" Style="{StaticResource BaseText}" FontSize="26"
                     TextWrapping="Wrap" Margin="0,0,0,16" />
          <ItemsControl x:Name="ReviewItems">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,0,6">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Number}" Style="{StaticResource MutedText}" MinWidth="160" />
                  <TextBlock Text="{Binding Value}" Style="{StaticResource BaseText}" TextWrapping="Wrap" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
      <StackPanel x:Name="DonePanel" Visibility="Collapsed">
        <TextBlock Text="&#x2713;" FontSize="72" FontWeight="Bold" HorizontalAlignment="Center"
                   Foreground="{StaticResource ReleasedFgBrush}" />
        <TextBlock Text="{x:Static res:Strings.WizDone}" Style="{StaticResource TitleDialog}"
                   HorizontalAlignment="Center" Margin="0,8,0,0" />
        <TextBlock x:Name="DoneLine" Style="{StaticResource BaseText}" FontSize="24" HorizontalAlignment="Center"
                   TextWrapping="Wrap" Margin="0,8,0,20" />
        <Button x:Name="NextPersonButton" Content="{x:Static res:Strings.WizNextPerson}"
                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" MinWidth="320"
                Click="NextPersonClick" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
          <Button x:Name="UndoButton" Content="{x:Static res:Strings.WizUndo}"
                  Style="{StaticResource QuietButton}" MinWidth="240" Click="UndoClick" />
          <Button x:Name="StopQueueButton" Content="{x:Static res:Strings.WizQueueStop}"
                  Style="{StaticResource PrimaryButton}" MinWidth="200" Click="StopQueueClick" />
          <Button x:Name="DoneCloseButton" Content="{x:Static res:Strings.WizClose}"
                  Style="{StaticResource PrimaryButton}" MinWidth="200" Click="DoneCloseClick" />
        </StackPanel>
      </StackPanel>
      <Border Style="{StaticResource WarnBand}" x:Name="ErrorBand" Visibility="Collapsed"
              VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
        <TextBlock x:Name="ErrorText" Style="{StaticResource BaseText}" TextWrapping="Wrap" />
      </Border>
    </Grid>
  </DockPanel>
</Window>