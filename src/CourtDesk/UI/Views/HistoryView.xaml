<UserControl x:Class="CourtDesk.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:CourtDesk.Resources"
             FlowDirection="RightToLeft">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{x:Static res:Strings.NavHistory}" Style="{StaticResource TitleWindow}" />
      <TextBox Style="{StaticResource InputBox}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
               Margin="0,0,0,8" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding EmptyText}" Style="{StaticResource BaseText}" />
    <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
              SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
              GridLinesVisibility="Horizontal" FontFamily="{StaticResource AppFont}" FontSize="20"
              ColumnHeaderHeight="52" RowBackground="{StaticResource CardBrush}"
              HorizontalGridLinesBrush="{StaticResource GridLineBrush}"
              Background="Transparent" BorderThickness="0"
              AlternatingRowBackground="{StaticResource CanvasBrush}"
              ScrollViewer.CanContentScroll="True"
              MouseDoubleClick="GridDoubleClick">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{x:Static res:Strings.HistWhen}" Binding="{Binding When}" Width="180" />
        <DataGridTemplateColumn Header="{x:Static res:Strings.GridName}" Width="1*"
                                MinWidth="200" MaxWidth="420">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Defendant}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{x:Static res:Strings.WizTitle}" Binding="{Binding Event}" Width="220" />
        <DataGridTextColumn Header="{x:Static res:Strings.GridSession}" Binding="{Binding NextDate}" Width="160" />
        <DataGridTextColumn Header="{x:Static res:Strings.FirstRunOperator}" Binding="{Binding Operator}" Width="160" />
        <DataGridTextColumn Header="{x:Static res:Strings.SideUndo}" Binding="{Binding Undone}" Width="120" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>