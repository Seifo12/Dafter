<UserControl x:Class="CourtDesk.UI.Views.TodaySidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:CourtDesk.Resources"
             FlowDirection="RightToLeft">
  <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,0,0,0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="12,12,12,8">
        <TextBlock Text="{x:Static res:Strings.SideTitle}" Style="{StaticResource TitleSection}" />
        <TextBlock x:Name="DateLine" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ProgressBar x:Name="ProgressBar" Grid.Row="0" Value="{Binding ProgressValue, Mode=OneWay}"
                       Minimum="0" Maximum="100" Height="8"
                       Foreground="{StaticResource ReleasedFgBrush}" Background="{StaticResource NoDateBgBrush}"
                       BorderThickness="0" />
          <TextBlock Grid.Row="1" Text="{Binding Progress}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </Grid>
      </StackPanel>

      <UniformGrid Grid.Row="1" Rows="1" Columns="2" Margin="12,0,12,8" x:Name="TabRow">
        <ToggleButton x:Name="TodayTab" Style="{StaticResource SidebarTab}" Content="{Binding TodayTabText}"
                      Command="{Binding TabCommand}" CommandParameter="today" />
        <ToggleButton x:Name="OverdueTab" Style="{StaticResource SidebarTab}" Content="{Binding OverdueTabText}"
                      Command="{Binding TabCommand}" CommandParameter="overdue" />
      </UniformGrid>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    x:Name="CardScroll">
        <StackPanel Margin="12,0,12,8">
          <ItemsControl x:Name="OverdueList" ItemsSource="{Binding OverdueCards}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Height="76" Margin="0,0,0,8" x:Name="CardRoot">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="6" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource OverdueFgBrush}" CornerRadius="4" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource NameText}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Line2}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Path Data="{StaticResource IconWarning}" Stroke="{StaticResource OverdueFgBrush}"
                              StrokeThickness="2" Fill="Transparent" Width="18" Height="18"
                              VerticalAlignment="Center" x:Name="OverdueIcon" />
                        <TextBlock Text="{Binding Line3}" Style="{StaticResource MutedText}" Margin="4,0,0,0"
                                   Foreground="{StaticResource OverdueFgBrush}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" MinHeight="48" Height="48"
                            MinWidth="112" Command="{Binding DataContext.RecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconGavel}" Stroke="{StaticResource WhiteBrush}" StrokeThickness="2"
                              Fill="Transparent" Width="20" Height="20" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static res:Strings.SideRecord}" Margin="4,0,0,0"
                                   VerticalAlignment="Center" FontSize="18" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl x:Name="PendingList" ItemsSource="{Binding PendingCards}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Height="76" Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="6" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource TodayFgBrush}" CornerRadius="4" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource NameText}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Line2}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" MinHeight="48" Height="48"
                            MinWidth="112" Command="{Binding DataContext.RecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconGavel}" Stroke="{StaticResource WhiteBrush}" StrokeThickness="2"
                              Fill="Transparent" Width="20" Height="20" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static res:Strings.SideRecord}" Margin="4,0,0,0"
                                   VerticalAlignment="Center" FontSize="18" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel x:Name="DecidedBlock">
            <TextBlock Text="{x:Static res:Strings.SideDecided}" Style="{StaticResource CardTitle}"
                       Margin="0,4,0,8" Foreground="{StaticResource MutedBrush}" />
            <ItemsControl ItemsSource="{Binding DecidedCards}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Height="76" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Background="{Binding Accent}" CornerRadius="4" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource NameText}" FontSize="20"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ResultSentence}" Style="{StaticResource MutedText}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="2" Style="{StaticResource QuietButton}" MinHeight="48" Height="48"
                              MinWidth="96" Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                          <Path Data="{StaticResource IconUndo}" Stroke="{StaticResource MutedBrush}" StrokeThickness="2"
                                Fill="Transparent" Width="20" Height="20" VerticalAlignment="Center" />
                          <TextBlock Text="{x:Static res:Strings.SideUndo}" Margin="6,0,0,0"
                                     VerticalAlignment="Center" FontSize="18" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="MoreDecidedText" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                       TextAlignment="Center" />
          </StackPanel>

          <TextBlock Text="{x:Static res:Strings.SideEmpty}" Style="{StaticResource MutedText}"
                     x:Name="EmptyText" TextWrapping="Wrap" Margin="0,12" />
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="3" Margin="12,0,12,12" x:Name="Footer">
        <Button Style="{StaticResource PrimaryButton}" MinHeight="60" Height="60" Command="{Binding PrintCommand}">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource IconPrinter}" Stroke="{StaticResource WhiteBrush}" StrokeThickness="2"
                  Fill="Transparent" Width="24" Height="24" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static res:Strings.SidePrint}" Margin="8,0,0,0" VerticalAlignment="Center"
                     FontSize="18" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <UniformGrid Rows="1" Columns="2" Margin="0,8,0,0">
          <Button x:Name="PreviewButton" Style="{StaticResource QuietButton}" MinHeight="48" Height="48"
                  Command="{Binding PreviewCommand}">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource IconEye}" Stroke="{StaticResource InkBrush}" StrokeThickness="2"
                    Fill="Transparent" Width="20" Height="20" VerticalAlignment="Center" />
              <TextBlock Text="{x:Static res:Strings.SidePreview}" Margin="6,0,0,0" VerticalAlignment="Center"
                     FontSize="18" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
          <Button x:Name="QueueButton" Style="{StaticResource QuietButton}" MinHeight="48" Height="48"
                  Command="{Binding QueueCommand}">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource IconQueue}" Stroke="{StaticResource InkBrush}" StrokeThickness="2"
                    Fill="Transparent" Width="20" Height="20" VerticalAlignment="Center" />
              <TextBlock Text="{x:Static res:Strings.SideQueue}" Margin="6,0,0,0" VerticalAlignment="Center"
                     FontSize="18" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
        </UniformGrid>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>