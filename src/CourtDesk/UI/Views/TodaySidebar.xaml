<UserControl x:Class="CourtDesk.UI.Views.TodaySidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:CourtDesk.Resources"
             FlowDirection="RightToLeft" Width="380">
  <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top" Margin="12,12,12,0">
      <TextBlock Text="{x:Static res:Strings.SideTitle}" Style="{StaticResource TitleSection}" />
      <TextBlock Text="{Binding DateLong}" Style="{StaticResource BaseText}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Progress}" Style="{StaticResource BaseText}" Margin="0,6,0,0" />
      <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Minimum="0" Maximum="100" Height="24" Margin="0,4,0,0"
                   Foreground="{StaticResource PrimaryBrush}" Background="{StaticResource SurfaceAltBrush}" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,12">
      <TextBlock Text="{Binding Tomorrow}" Style="{StaticResource BaseText}" FontSize="18" Margin="0,6" TextWrapping="Wrap" />
      <Button Content="{x:Static res:Strings.SidePrint}" Style="{StaticResource PrintButton}"
              Command="{Binding PrintCommand}" />
      <Button Content="{x:Static res:Strings.SidePreview}" Style="{StaticResource BigButton}"
              Command="{Binding PreviewCommand}" />
    </StackPanel>
    <ScrollViewer Style="{StaticResource WideScrollViewer}" Margin="0,6">
      <StackPanel Margin="12,0">
        <StackPanel x:Name="OverdueBlock">
          <TextBlock Text="{Binding OverdueHeader}" Style="{StaticResource BaseText}" FontWeight="Bold"
                     Foreground="{StaticResource OverdueAccentBrush}" TextWrapping="Wrap" Margin="0,8,0,4" />
          <ItemsControl ItemsSource="{Binding OverdueCards}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource OverdueAccentBrush}" BorderThickness="0,0,8,0"
                        Background="{StaticResource OverdueBgBrush}" Padding="12,8" Margin="0,0,0,10">
                  <StackPanel>
                    <Button Content="{Binding Name}" Style="{StaticResource SmallButton}" Tag="{Binding}"
                            FontSize="22" HorizontalContentAlignment="Right" />
                    <TextBlock Text="{Binding Line2}" Style="{StaticResource BaseText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Line3}" Style="{StaticResource BaseText}" FontWeight="Bold" TextWrapping="Wrap" />
                    <Button Content="{x:Static res:Strings.SideRecord}" Style="{StaticResource SmallButton}"
                            Command="{Binding DataContext.RecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" MinHeight="56" Margin="0,6,0,0" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <Button Content="{x:Static res:Strings.SideQueue}" Style="{StaticResource SmallButton}"
                Command="{Binding QueueCommand}" Margin="0,4,0,8" />
        <ItemsControl ItemsSource="{Binding PendingCards}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource TodayAccentBrush}" BorderThickness="0,0,8,0"
                      Background="{StaticResource TodayBgBrush}" Padding="12,8" Margin="0,0,0,10">
                <StackPanel>
                  <Button Content="{Binding Name}" Style="{StaticResource SmallButton}" Tag="{Binding}"
                          FontSize="22" HorizontalContentAlignment="Right" />
                  <TextBlock Text="{Binding Line2}" Style="{StaticResource BaseText}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Line3}" Style="{StaticResource BaseText}" TextWrapping="Wrap" />
                  <Button Content="{x:Static res:Strings.SideRecord}" Style="{StaticResource SmallButton}"
                          Command="{Binding DataContext.RecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" MinHeight="56" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding DecidedCards}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource UpcomingAccentBrush}" BorderThickness="0,0,8,0"
                      Background="{StaticResource SurfaceBrush}" Padding="12,8" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource CardName}" />
                  <TextBlock Text="{Binding ResultSentence}" Style="{StaticResource BaseText}" TextWrapping="Wrap" />
                  <Button Content="{x:Static res:Strings.SideUndo}" Style="{StaticResource SmallButton}"
                          Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" MinHeight="48" Margin="0,6,0,0"
                          HorizontalAlignment="Left" MinWidth="120" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{x:Static res:Strings.SideEmpty}" Style="{StaticResource BaseText}"
                   x:Name="EmptyText" TextWrapping="Wrap" Margin="0,12" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
