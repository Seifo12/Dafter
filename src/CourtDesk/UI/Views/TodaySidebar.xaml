<UserControl x:Class="CourtDesk.UI.Views.TodaySidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:CourtDesk.Resources"
             FlowDirection="RightToLeft">
  <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,0,0,0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="12,8,12,6">
        <TextBlock Text="{x:Static res:Strings.SideTitle}" Style="{StaticResource TitleSection}" />
        <TextBlock x:Name="DateLine" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
        <Grid Margin="0,6,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ProgressBar x:Name="ProgressBar" Grid.Row="0" Value="{Binding ProgressValue, Mode=OneWay}"
                       Minimum="0" Maximum="100" Height="8"
                       Foreground="{StaticResource ReleasedFgBrush}" Background="{StaticResource NoDateBgBrush}"
                       BorderThickness="0" />
          <TextBlock Grid.Row="1" Text="{Binding Progress}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </Grid>
      </StackPanel>

      <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="12,0,12,6" x:Name="TabRow"
                   MinWidth="90" HorizontalAlignment="Stretch">
        <ToggleButton x:Name="TodayTab" Style="{StaticResource SidebarTabCompact}" Content="{Binding TodayTabText}"
                      MinWidth="0" Margin="0,0,3,0"
                      Command="{Binding TabCommand}" CommandParameter="today" />
        <ToggleButton x:Name="TomorrowTab" Style="{StaticResource SidebarTabCompact}" Content="{Binding TomorrowTabText}"
                      MinWidth="0" Margin="3,0"
                      Command="{Binding TabCommand}" CommandParameter="tomorrow" />
        <ToggleButton x:Name="OverdueTab" Style="{StaticResource SidebarTabCompact}" Content="{Binding OverdueTabText}"
                      MinWidth="0" Margin="3,0,0,0"
                      Command="{Binding TabCommand}" CommandParameter="overdue" />
      </UniformGrid>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    x:Name="CardScroll">
        <StackPanel Margin="12,0,12,8">
          <ItemsControl x:Name="OverdueList" ItemsSource="{Binding OverdueCards}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,0,0,8" MinHeight="92" Padding="0" x:Name="CardRoot">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="6" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource OverdueFgBrush}" CornerRadius="4" Margin="0,6,0,6" />
                    <StackPanel Grid.Column="1" Margin="8">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource NameText}" TextWrapping="Wrap"
                                 Cursor="Hand" MouseLeftButtonUp="NameClick" />
                      <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Line2}" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" MinHeight="44" Height="44"
                                MinWidth="120" Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center"
                                Command="{Binding DataContext.RecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconGavel}" Stroke="{StaticResource WhiteBrush}" StrokeThickness="2"
                                  Fill="Transparent" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static res:Strings.SideRecord}" Margin="4,0,0,0"
                                       VerticalAlignment="Center" FontSize="18" />
                          </StackPanel>
                        </Button>
                      </Grid>
                      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Path Data="{StaticResource IconWarning}" Stroke="{StaticResource OverdueFgBrush}"
                              StrokeThickness="2" Fill="Transparent" Width="18" Height="18"
                              VerticalAlignment="Center" x:Name="OverdueIcon" />
                        <TextBlock Text="{Binding Line3}" Style="{StaticResource MutedText}" Margin="4,0,0,0"
                                   Foreground="{StaticResource OverdueFgBrush}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl x:Name="PendingList" ItemsSource="{Binding PendingCards}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,0,0,8" MinHeight="92" Padding="0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="6" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource TodayFgBrush}" CornerRadius="4" Margin="0,6,0,6" />
                    <StackPanel Grid.Column="1" Margin="8">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource NameText}" TextWrapping="Wrap"
                                 Cursor="Hand" MouseLeftButtonUp="NameClick" />
                      <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Line2}" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" MinHeight="44" Height="44"
                                MinWidth="120" Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center"
                                Command="{Binding DataContext.RecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconGavel}" Stroke="{StaticResource WhiteBrush}" StrokeThickness="2"
                                  Fill="Transparent" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static res:Strings.SideRecord}" Margin="4,0,0,0"
                                       VerticalAlignment="Center" FontSize="18" />
                          </StackPanel>
                        </Button>
                      </Grid>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl x:Name="TomorrowList" ItemsSource="{Binding TomorrowCards}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,0,0,8" MinHeight="92" Padding="0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="6" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource UpcomingFgBrush}" CornerRadius="4" Margin="0,6,0,6" />
                    <StackPanel Grid.Column="1" Margin="8">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource NameText}" TextWrapping="Wrap"
                                 Cursor="Hand" MouseLeftButtonUp="NameClick" />
                      <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Line2}" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" MinHeight="44" Height="44"
                                MinWidth="120" Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center"
                                Command="{Binding DataContext.RecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconGavel}" Stroke="{StaticResource WhiteBrush}" StrokeThickness="2"
                                  Fill="Transparent" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static res:Strings.SideRecord}" Margin="4,0,0,0"
                                       VerticalAlignment="Center" FontSize="18" />
                          </StackPanel>
                        </Button>
                      </Grid>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel x:Name="DecidedBlock">
            <TextBlock Text="{x:Static res:Strings.SideDecided}" Style="{StaticResource CardTitle}"
                       Margin="0,4,0,8" Foreground="{StaticResource MutedBrush}" />
            <ScrollViewer x:Name="DecidedStrip" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding DecidedCards}" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Card}" MinWidth="190" MaxWidth="260" Margin="0,0,8,0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="6" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{Binding Accent}" CornerRadius="4" Margin="0,6,0,6" />
                        <StackPanel Grid.Column="1" Margin="8" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" Style="{StaticResource NameText}" FontSize="20"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="{Binding ResultSentence}" Style="{StaticResource MutedText}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0"
                        x:Name="DecidedMoreRow">
              <TextBlock x:Name="MoreDecidedText" Style="{StaticResource MutedText}"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button x:Name="DecidedToggle" Style="{StaticResource QuietButton}" MinHeight="48" Height="48"
                      MinWidth="120" Command="{Binding ToggleDecidedCommand}" />
            </StackPanel>
          </StackPanel>

          <TextBlock Text="{x:Static res:Strings.SideEmpty}" Style="{StaticResource MutedText}"
                     x:Name="EmptyText" TextWrapping="Wrap" Margin="0,12" />
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="3" Margin="12,0,12,8" x:Name="Footer">
        <TextBlock Text="{x:Static res:Strings.ScopeDateLabel}" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button x:Name="ScopePrevDay" Style="{StaticResource QuietButton}" Content="-"
                  Click="ScopePrevDayClick" MinHeight="48" MinWidth="64" Margin="0,0,6,0" />
          <TextBlock x:Name="ScopeDateText" Style="{StaticResource GridStrong}"
                     VerticalAlignment="Center" MinWidth="120" TextAlignment="Center" />
          <Button x:Name="ScopeNextDay" Style="{StaticResource QuietButton}" Content="+"
                  Click="ScopeNextDayClick" MinHeight="48" MinWidth="64" Margin="6,0,0,0" />
        </StackPanel>
        <TextBlock Text="{x:Static res:Strings.ExcelScope}" Style="{StaticResource MutedText}"
                   Margin="0,0,0,4" />
        <ComboBox x:Name="PrintScopeBox" Style="{StaticResource BigCombo}" MinHeight="48" Margin="0,0,0,8"
                  SelectionChanged="PrintScopeChanged">
          <ComboBoxItem Content="{x:Static res:Strings.ExcelScopeAll}" Tag="ALL" IsSelected="True" />
          <ComboBoxItem Content="{x:Static res:Strings.ExcelScopeDetained}" Tag="DETAINED" />
          <ComboBoxItem Content="{x:Static res:Strings.ExcelScopeReleased}" Tag="RELEASED" />
          <ComboBoxItem Content="{x:Static res:Strings.ExcelScopeJudged}" Tag="JUDGED" />
          <ComboBoxItem Content="{x:Static res:Strings.ExcelScopeNoDate}" Tag="NO_DATE" />
        </ComboBox>
        <Button Style="{StaticResource PrimaryButton}" MinHeight="56" Height="56" Command="{Binding PrintCommand}">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource IconPrinter}" Stroke="{StaticResource WhiteBrush}" StrokeThickness="2"
                  Fill="Transparent" Width="24" Height="24" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static res:Strings.SidePrint}" Margin="8,0,0,0" VerticalAlignment="Center"
                     FontSize="18" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <UniformGrid Rows="1" Columns="2" Margin="0,6,0,0">
          <Button x:Name="PreviewButton" Style="{StaticResource QuietButton}" MinHeight="44" Height="44"
                  Command="{Binding PreviewCommand}">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource IconEye}" Stroke="{StaticResource InkBrush}" StrokeThickness="2"
                    Fill="Transparent" Width="20" Height="20" VerticalAlignment="Center" />
              <TextBlock Text="{x:Static res:Strings.SidePreview}" Margin="6,0,0,0" VerticalAlignment="Center"
                     FontSize="18" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
          <Button x:Name="QueueButton" Style="{StaticResource QuietButton}" MinHeight="44" Height="44"
                  Command="{Binding QueueCommand}">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource IconQueue}" Stroke="{StaticResource InkBrush}" StrokeThickness="2"
                    Fill="Transparent" Width="20" Height="20" VerticalAlignment="Center" />
              <TextBlock Text="{x:Static res:Strings.SideQueue}" Margin="6,0,0,0" VerticalAlignment="Center"
                     FontSize="18" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
        </UniformGrid>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>