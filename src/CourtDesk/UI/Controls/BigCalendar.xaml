<UserControl x:Class="CourtDesk.UI.Controls.BigCalendar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:CourtDesk.Resources"
             xmlns:ctl="clr-namespace:CourtDesk.UI.Controls"
             FlowDirection="RightToLeft">
  <StackPanel>
    <Grid Margin="4">
      <Button Content="&#x2190;" Style="{StaticResource QuietButton}" MinWidth="60" HorizontalAlignment="Right"
              Click="PrevMonth" AutomationProperties.Name="{x:Static res:Strings.CalPrev}" />
      <TextBlock x:Name="Title" Style="{StaticResource TitleSection}" FontSize="24" HorizontalAlignment="Center" />
      <Button Content="&#x2192;" Style="{StaticResource QuietButton}" MinWidth="60" HorizontalAlignment="Left"
              Click="NextMonth" AutomationProperties.Name="{x:Static res:Strings.CalNext}" />
    </Grid>
    <UniformGrid x:Name="WeekHeader" Rows="1" Columns="7" Margin="4,0">
      <TextBlock Text="{x:Static res:Strings.CalSat}" Style="{StaticResource ChipText}" TextAlignment="Center" Margin="2" />
      <TextBlock Text="{x:Static res:Strings.CalSun}" Style="{StaticResource ChipText}" TextAlignment="Center" Margin="2" />
      <TextBlock Text="{x:Static res:Strings.CalMon}" Style="{StaticResource ChipText}" TextAlignment="Center" Margin="2" />
      <TextBlock Text="{x:Static res:Strings.CalTue}" Style="{StaticResource ChipText}" TextAlignment="Center" Margin="2" />
      <TextBlock Text="{x:Static res:Strings.CalWed}" Style="{StaticResource ChipText}" TextAlignment="Center" Margin="2" />
      <TextBlock Text="{x:Static res:Strings.CalThu}" Style="{StaticResource ChipText}" TextAlignment="Center" Margin="2" />
      <TextBlock Text="{x:Static res:Strings.CalFri}" Style="{StaticResource ChipText}" TextAlignment="Center" Margin="2" />
    </UniformGrid>
    <ItemsControl x:Name="Cells" Width="560">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="6" Columns="7" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Content="{Binding Number}" MinWidth="76" MinHeight="60" Margin="2" FontSize="24"
                  Tag="{Binding}"
                  Click="CellClick"
                  Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ctl:BigCalendar}}"
                  CommandParameter="{Binding}">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="6">
                  <Grid>
                    <TextBlock Text="{Binding Number}" FontSize="24" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" />
                    <TextBlock x:Name="Badge" Text="{Binding Count}" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,2"
                               Foreground="{StaticResource PrimaryBrush}" />
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource CanvasBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding InMonth}" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource NoDateBgBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                  </DataTrigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusYellowBrush}" />
                    <Setter TargetName="Bd" Property="BorderThickness" Value="3" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>