<UserControl x:Class="CourtDesk.UI.Controls.StatusChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
  <Border x:Name="BackBorder" CornerRadius="14" Padding="10,3" MinHeight="32"
          BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Left">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Path x:Name="GlyphPath" Width="18" Height="18" Stretch="Uniform"
            StrokeThickness="2" VerticalAlignment="Center" />
      <TextBlock x:Name="WordText" Style="{StaticResource ChipText}" VerticalAlignment="Center" Margin="6,0,0,0" />
    </StackPanel>
  </Border>
</UserControl>