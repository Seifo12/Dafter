<UserControl x:Class="CourtDesk.UI.Controls.StatusChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" MinHeight="40">
  <Border x:Name="BackBorder" CornerRadius="20" Padding="14,4" MinHeight="40"
          BorderThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Path x:Name="GlyphPath" Width="20" Height="20" Stretch="Uniform"
            StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,0,0" />
      <TextBlock x:Name="WordText" Style="{StaticResource ChipText}" VerticalAlignment="Center" Margin="8,0,0,0" />
    </StackPanel>
  </Border>
</UserControl>
