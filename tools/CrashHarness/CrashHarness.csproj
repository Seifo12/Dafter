<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>CrashHarness</AssemblyName>
    <RootNamespace>CrashHarness</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\CourtDesk\Domain\**\*.cs" Link="Domain\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\CourtDesk\Persistence\**\*.cs" Link="Persistence\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\CourtDesk\Application\Ports\**\*.cs" Link="Ports\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\CourtDesk\Resources\Strings.cs" Link="Resources\Strings.cs" />
    <EmbeddedResource Include="..\..\src\CourtDesk\Persistence\Migrations\001_initial.sql" Link="Migrations\001_initial.sql" />
    <Reference Include="System.Data.SQLite">
      <HintPath>..\..\vendor\managed\System.Data.SQLite.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Web.Extensions" />
    <None Include="..\..\vendor\native\x86\SQLite.Interop.dll" Link="x86\SQLite.Interop.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
